# OWLEXIA Legal AI Agent Environment Configuration

# Application Host, Port, and Workers
HOST=0.0.0.0
PORT=8000
WORKERS=2

# PostgreSQL Database Connection
DATABASE_URL=postgresql://owlexia:owlexia_pass@localhost:5432/owlexia_db

# LLM Reasoning Engine (Gemini Integration)
# REASONER_MODE: "llm" (Gemini API with multi-model failover) or "heuristic" (rule-based)
REASONER_MODE=llm
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# System Prompt Configuration (Auto hot-reloading)
SYSTEM_PROMPT_PATH=prompts/system_prompt.md

# Cloudflare R2 Storage Configuration (PDF Resolution & Public CDN)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_BUCKET_NAME=owlexia-r2
R2_API_TOKEN=your_cloudflare_r2_api_token
R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev
